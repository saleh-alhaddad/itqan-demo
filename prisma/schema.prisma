// Domain schema for the task-management MVP. Mirrors spec.md's data model exactly.
//
// Two structural rules are enforced here rather than in application code:
//   I1/I2 — a Board reaches its team directly and a Task reaches its board only through
//           Column. There is deliberately NO teamId on Task: one ownership path cannot
//           disagree with itself, and every access check is a Membership lookup.
//   I7   — onDelete: Cascade runs the whole chain, so "no orphans" is a database property
//          rather than something every future delete has to remember.
//
// I3: there is no `status` field anywhere. A task's Column IS its status.
// D1: `position` is a dense integer with NO unique constraint — see plan.md.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

// The citext extension is created by the initial migration's SQL rather than declared
// here: `extensions = [...]` requires the postgresqlExtensions PREVIEW feature, and a
// preview flag is a poor trade for one CREATE EXTENSION line.
datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  MEMBER
}

model User {
  id           String   @id @default(uuid())
  /// citext, so "Ada@x" and "ada@x" are the same account. Enforced by the database
  /// instead of by lowercasing at each call site, which a future query can forget.
  email        String   @unique @db.Citext
  passwordHash String
  name         String
  createdAt    DateTime @default(now())

  memberships Membership[]
  assignments TaskAssignee[]
  comments    Comment[]
  sessions    Session[]
}

/// Server-side sessions (gate decision Q19): the cookie carries only this opaque token,
/// so logout deletes the row and revocation is real rather than client-side.
model Session {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/**
 * Failed-authentication counters, for the login/signup throttle (harden C1).
 *
 * In the database rather than in memory: an in-process counter resets on every restart and
 * is not shared between instances, which makes it worthless on the serverless hosting the
 * spec deliberately kept viable. Same reasoning that made sessions DB-backed.
 *
 * One row per (key, kind) — the key is an IP or an email address, so a single attacker
 * cannot escape the count by varying the other.
 */
model AuthAttempt {
  id            String   @id @default(uuid())
  /// "ip:203.0.113.7" or "email:someone@example.test"
  key           String
  /// "login" or "signup"
  kind          String
  failures      Int      @default(0)
  /// Attempts before this instant are refused with 429. NOT a lock: it always elapses.
  nextAttemptAt DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([key, kind])
  /// Lets a cleanup job find stale rows without scanning.
  @@index([updatedAt])
}

model Team {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())

  memberships Membership[]
  boards      Board[]
}

/// The authorization primitive: the EXISTENCE of this row is what grants access (I2).
model Membership {
  id        String   @id @default(uuid())
  userId    String
  teamId    String
  role      Role     @default(MEMBER)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId])
  @@index([teamId])
}

model Board {
  id        String   @id @default(uuid())
  teamId    String
  name      String
  createdAt DateTime @default(now())

  team    Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  columns Column[]

  @@index([teamId])
}

model Column {
  id        String   @id @default(uuid())
  boardId   String
  name      String
  /// Dense from 0, rewritten wholesale inside one transaction on reorder (I5/D1).
  /// Intentionally NOT unique: a dense shift transiently collides, and the transaction
  /// already provides the guarantee a unique constraint would cost two phases to keep.
  position  Int
  createdAt DateTime @default(now())

  board Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tasks Task[]

  @@index([boardId, position])
}

model Task {
  id          String    @id @default(uuid())
  columnId    String
  title       String
  description String?
  /// A calendar DATE, never a timestamp — "due the 14th" must mean the 14th for every
  /// viewer, in every timezone.
  dueDate     DateTime? @db.Date
  position    Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  column    Column         @relation(fields: [columnId], references: [id], onDelete: Cascade)
  assignees TaskAssignee[]
  comments  Comment[]

  @@index([columnId, position])
}

/// I4: every row here must be a member of the team owning the task's board. Removing a
/// Membership deletes the matching rows (done inside the removal transaction, T13) so
/// the invariant is never transiently false.
model TaskAssignee {
  taskId    String
  userId    String
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([userId])
}

model Comment {
  id        String   @id @default(uuid())
  taskId    String
  authorId  String
  body      String
  createdAt DateTime @default(now())

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([taskId])
}
